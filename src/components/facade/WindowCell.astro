---
import { Image } from 'astro:assets';
import type { GridCell } from './gridLayout';

interface Props {
  cell: GridCell;
}

const { cell } = Astro.props;
---

{
  cell.type === 'dead' ? (
    <div class="cell cell--dead" aria-hidden="true" />
  ) : (
    <a
      href={`/works/${cell.work.id}/`}
      class="cell cell--work"
      data-ignite="true"
    >
      <Image
        src={cell.work.data.thumbnail}
        alt=""
        width={240}
        height={320}
        loading="lazy"
        class="cell__thumb"
        transition:name={`work-${cell.work.id}`}
      />
      <span class="cell__caption">
        <span class="cell__caption-title font-display">
          {cell.work.data.titleEn ?? cell.work.data.title}
        </span>
        <span class="cell__caption-summary font-mono">{cell.work.data.summary}</span>
      </span>
    </a>
  )
}

<style is:global>
  @layer components {
    .cell {
      aspect-ratio: 3 / 4;
      border-radius: var(--radius-cell);
      background: var(--c-facade);
      overflow: hidden;
    }

    .cell--work {
      display: block;
      background: var(--c-facade-lit);
      /* 消灯は遅く。ホバーが外れたときの余韻。 */
      transition:
        background var(--dur-base) var(--ease-inout),
        box-shadow var(--dur-base) var(--ease-inout);
    }

    .cell--work:hover,
    .cell--work:focus-visible {
      background: var(--c-signal);
      /* グローの唯一の例外: 一度に1セルしか光らないため面積原則を破らない */
      box-shadow: 0 0 24px -4px var(--c-signal);
      /* 点灯は速く。 */
      transition:
        background var(--dur-fast) var(--ease-out),
        box-shadow var(--dur-fast) var(--ease-out);
    }

    .cell__thumb {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity var(--dur-base) var(--ease-inout);
    }

    .cell--work:hover .cell__thumb,
    .cell--work:focus-visible .cell__thumb {
      opacity: 1;
      transition: opacity var(--dur-fast) var(--ease-out);
    }

    /* 作品名はセル内ではなく、グリッド上部の固定位置に表示する（3:4では文字が読めないため） */
    .cell__caption {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: var(--space-2) var(--space-3);
      background: var(--c-void);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-fast) var(--ease-out);
    }

    .cell--work:hover .cell__caption,
    .cell--work:focus-visible .cell__caption {
      opacity: 1;
    }

    .cell__caption-title {
      color: var(--c-fluorescent);
      font-size: var(--fs-h2);
    }

    .cell__caption-summary {
      color: var(--c-dust);
      font-size: var(--fs-small);
    }

    @media (prefers-reduced-motion: reduce) {
      .cell--work,
      .cell__thumb,
      .cell__caption {
        transition: none;
      }
    }
  }
</style>
